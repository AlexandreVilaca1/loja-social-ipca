# Firebase Trigger Email extension — instance "firestore-send-email-o0e9" (see firebase.json).
# Copy to extensions/firestore-send-email-o0e9.env and fill in the values. Never commit the .env file.
# Emails are sent by adding documents to the Firestore collection MAIL_COLLECTION.

AUTH_TYPE=OAuth2
DATABASE=(default)
DATABASE_REGION=europe-west1
DEFAULT_FROM=noreply@example.com
DEFAULT_REPLY_TO=support@example.com
firebaseextensions.v1beta.function/location=europe-west1
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=false
# Connection string WITHOUT the password, e.g. smtps://user@smtp.example.com:465
SMTP_CONNECTION_URI=smtps://your-smtp-user@smtp.example.com:465
# Reference to a Secret Manager secret — the password itself is never stored here
SMTP_PASSWORD=projects/${param:PROJECT_NUMBER}/secrets/firestore-send-email-o0e9-SMTP_PASSWORD/versions/latest
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
