# Firebase Trigger Email extension — instance "firestore-send-email-42u2" (see firebase.json).
# Copy to extensions/firestore-send-email-42u2.env and fill in the values. Never commit the .env file.
# Emails are sent by adding documents to the Firestore collection MAIL_COLLECTION.

AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=europe-west1
DEFAULT_FROM=noreply@example.com
DEFAULT_REPLY_TO=support@example.com
firebaseextensions.v1beta.function/location=europe-west1
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=false
# Connection string WITHOUT the password, e.g. smtps://user@smtp.example.com:465
SMTP_CONNECTION_URI=smtps://your-smtp-user@smtp.example.com:465
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
